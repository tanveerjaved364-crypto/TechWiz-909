# Copy this file to .env, then place your own private values after the equals sign.
# Never commit or send the real .env file to classmates, GitHub, or chat.
MONGODB_URI=
MONGODB_CONNECT_TIMEOUT_MS=5000
MONGODB_SYNC_ON_START=false
SKILLSPRINT_AI_PROVIDER=groq
GROQ_API_KEY=
SKILLSPRINT_GROQ_MODEL=openai/gpt-oss-120b
SKILLSPRINT_GENAI_TIMEOUT=55
SKILLSPRINT_GENAI_ATTEMPTS=1
SKILLSPRINT_GENAI_MAX_TOKENS=3500
SKILLSPRINT_AI_ENRICHMENT_LIMIT=12
SKILLSPRINT_APP_URL=http://localhost:5000
SKILLSPRINT_SECRET_KEY=
